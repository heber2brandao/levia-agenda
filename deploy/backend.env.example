# Copiar para deploy/.env.backend; NÃO usar credencial postgres/service_role.
LEVIA_ENVIRONMENT=production
LEVIA_DATABASE_URL=
# Na URL real: sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
LEVIA_SUPABASE_URL=
LEVIA_RATE_LIMIT_SECRET=
LEVIA_PUBLIC_WEB_URL=
# Substituir DOMINIO_REAL pelo domínio escolhido.
LEVIA_ALLOWED_HOSTS=["DOMINIO_REAL","127.0.0.1"]
LEVIA_CORS_ORIGINS=["https://DOMINIO_REAL"]
LEVIA_EMAIL_ENABLED=false
LEVIA_WORKER_OWNER_IDS=[]
LEVIA_WORKER_POLL_SECONDS=30
# Só após domínio Resend e HTTPS verificados:
# LEVIA_RESEND_API_KEY=
# LEVIA_EMAIL_FROM=
# LEVIA_EMAIL_UNSUBSCRIBE_SECRET=
