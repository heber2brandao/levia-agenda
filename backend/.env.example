# Copie para .env em backend. Sem credenciais reais neste exemplo.
LEVIA_APP_NAME=Levia Agenda
LEVIA_ENVIRONMENT=development
LEVIA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:4187"]
# Descomente após configurar seu projeto. Nunca use postgres/service_role na API.
# LEVIA_DATABASE_URL=   # postgresql+psycopg, papel levia_app
# LEVIA_MIGRATION_DATABASE_URL=   # papel administrador, usado só por Alembic
# LEVIA_SUPABASE_URL=   # URL https do projeto, sem /auth/v1 no final
# LEVIA_RATE_LIMIT_SECRET=   # segredo aleatório com pelo menos 32 caracteres
LEVIA_JWT_AUDIENCE=authenticated
LEVIA_RATE_LIMIT_PER_MINUTE=60

# Etapa 5: nunca habilite antes de verificar domínio, remetente e worker.
LEVIA_EMAIL_ENABLED=false
LEVIA_WORKER_OWNER_IDS=[]
LEVIA_WORKER_POLL_SECONDS=30
# LEVIA_RESEND_API_KEY=        # chave com permissão de envio, somente no servidor
# LEVIA_EMAIL_FROM=           # endereço no domínio verificado
# LEVIA_PUBLIC_WEB_URL=       # origem HTTPS pública do frontend
# LEVIA_EMAIL_UNSUBSCRIBE_SECRET= # segredo aleatório de 32+ caracteres; API e worker usam o mesmo
# WORKER_OWNER_IDS é uma lista JSON de UUIDs auth.users.id explicitamente autorizados.
# A franquia padrão de 100 está em professionals.monthly_email_limit (alteração administrativa).
